#!/bin/sh
# Bootstrap gradlew: if gradle-wrapper.jar is missing, fetch it via a minimal download,
# otherwise fall back to a system gradle (available on Codemagic machines).
APP_BASE_NAME=$(basename "$0")
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
JARPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
PROPS="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"
URL=$(grep distributionUrl "$PROPS" | sed 's/.*=//; s/\\:/:/')

if [ ! -f "$JARPATH" ]; then
  mkdir -p "$APP_HOME/gradle/wrapper"
  echo "Downloading gradle wrapper jar..."
  curl -fsSL -o "$JARPATH" https://raw.githubusercontent.com/gradle/gradle/v8.7.0/gradle/wrapper/gradle-wrapper.jar \
    || wget -q -O "$JARPATH" https://raw.githubusercontent.com/gradle/gradle/v8.7.0/gradle/wrapper/gradle-wrapper.jar
fi

if [ -f "$JARPATH" ]; then
  exec java -jar "$JARPATH" "$@"
else
  echo "gradle-wrapper.jar unavailable; falling back to system gradle"
  exec gradle "$@"
fi
